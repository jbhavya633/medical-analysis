{
  "name": "medical-analysis-platform",
  "version": "2.0.0",
  "description": "Advanced Multi-modality Medical Analysis Platform with AI Integration",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:ml": "cd ml && python -m uvicorn inference.server:app --reload --port 8000",
    "build": "tsc && vite build",
    "build:frontend": "vite build",
    "build:backend": "cd backend && python -m pip install -r requirements.txt",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
